---
import Layout from "../layouts/Layout.astro";

const siteBase = "https://drmedovarski.com";

const faqSchema = [
  {
    question: "Da li pružate psihoterapiju na srpskom jeziku za dijasporu?",
    answer:
      "Da. Dr Tamara Medovarski pruža online psihoterapiju na srpskom jeziku za klijente koji žive u inostranstvu - u Holandiji, Nemačkoj, Austriji, Švajcarskoj, Australiji i drugde. Online format omogućava rad bez obzira na lokaciju.",
  },
  {
    question:
      "Zašto je važno raditi sa terapeutom koji razume balkanski kulturni kontekst?",
    answer:
      "Kulturni kontekst igra ključnu ulogu u psihoterapiji. Terapeut koji razume dinamiku porodičnih odnosa, kolektivnih vrednosti, obrasce vaspitanja i specifičnosti iskustva dijaspore može preciznije interpretirati emocionalne i bihejvioralne obrasce, bez kulturne diskriminacije ili nesporazuma.",
  },
  {
    question: "Koje probleme najčešće obrađujete sa klijentima iz dijaspore?",
    answer:
      "Najčešće teme uključuju: poteškoće u integraciji u novu kulturu, osećaj gubitka kulturnog identiteta, osećaj nerazumevanja, probleme u ostvarivanju novih prijateljskih i relacionih odnosa, usamljenost i izolaciju u inostranstvu, nostalgiju i krivicu prema porodici u Srbiji, anksioznost i depresiju vezane za emigraciju, poteškoće sa prihvatanjem činjenice da život u inostranstvu nije drastično bolji od života u domovini, nasuprot inicijalnim očekivanjima.",
  },
  {
    question: "Kako zakazati prvu seansu?",
    answer:
      "Ispunite kontakt formu ili me kontaktirajte putem WhatsApp / Viber na +31 6 48569129. Pre prve seanse nudim besplatni 15-minutni uvodni razgovor.",
    answerHtml: `Ispunite <a style="text-decoration: underline;" href="/sr/contact/">kontakt formu</a> ili me kontaktirajte putem WhatsApp / Viber na +31 6 48569129. Pre prve seanse nudim besplatni 15-minutni uvodni razgovor.`,
  },
];

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Psihoterapija za dijasporu",
      description:
        "Online psihoterapija na srpskom jeziku za osobe balkanskog porekla koje žive u inostranstvu",
      url: `${siteBase}/psihoterapija-za-dijasporu/`,
      provider: {
        "@type": "Person",
        name: "Dr Tamara Medovarski",
        knowsLanguage: ["sr", "en", "nl"],
      },
      areaServed: [
        "Netherlands",
        "Germany",
        "Austria",
        "Switzerland",
        "Australia",
        "Global",
      ],
      availableLanguage: [
        { "@type": "Language", name: "Serbian" },
        { "@type": "Language", name: "English" },
        { "@type": "Language", name: "Dutch" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqSchema.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
});
---

<Layout
  title="Psihoterapija za dijasporu | Online na srpskom jeziku - Dr Tamara Medovarski"
  description="Online psihoterapija na srpskom jeziku za Srbe u inostranstvu. Specijalizovana podrška za dijasporu u Holandiji, Nemačkoj, Australiji i drugde. Zakažite konsultacije."
  lang="sr"
  noAlternates={true}
>
  <script type="application/ld+json" set:html={schemaJson} />

  <div class="page-container">
    <article class="landing-content">
      <h1>Psihoterapija za dijasporu</h1>

      <p class="lead">
        Život u inostranstvu donosi brojne izazove za mentalno zdravlje. Dr
        Tamara Medovarski pruža online psihoterapiju na srpskom jeziku
        specijalno prilagođenu potrebama dijaspore - klijentima iz Holandije,
        Nemačke, Austrije, Švajcarske, Australije i celog sveta.
      </p>

      <section class="section">
        <h2>Zašto je psihoterapija za dijasporu zahteva drugačiji pristup?</h2>
        <p>
          Rad sa terapeutom koji razume balkanski kulturni kontekst nije luksuz
          - to je psihoterapijska neophodnost. Kulturni kontekst oblikuje naše
          emocije, obrasce ponašanja i načine na koje se nosimo sa stresom.
          Terapeut bez tog razumevanja može pogrešno interpretirati psiholoske
          obrasce.
        </p>
        <p>
          Dr Tamara Medovarski je i sama godinama živela, obrazovala se i radila
          u Holandiji i razume specifičnosti iskustva emigracije -
          prilagođavanje novoj kulturi, nostalgiju za domovinom, pritisak
          porodičnih očekivanja i izazov pronalaženja identiteta između dve
          kulture.
        </p>
      </section>

      <section class="section">
        <h2>Česti izazovi dijaspore u psihoterapiji</h2>
        <div class="challenges-grid">
          <div class="challenge-card">
            <h3>Kulturni identitet</h3>
            <p>
              Osećaj da ne pripadate ni „ovde" ni „tamo". Teškoće u balansiranju
              balkanskog nasleđa i nove kulture.
            </p>
          </div>
            <div class="challenge-card">
              <h3>Usamljenost i izolacija</h3>
              <p>
                Nedostatak bliskih veza u novoj sredini. Jezik i kulturne
                razlike kao prepreka za dublje konekcije.
              </p>
            </div>
            <div class="challenge-card">
              <h3>Anksioznost i stres emigracije</h3>
              <p>
                Neizvesnost statusa, brige oko integracije, profesionalnih
                izazova u novoj sredini.
              </p>
            </div>
            <div class="challenge-card">
              <h3>Nostalgija i krivica</h3>
              <p>
                Osećaj krivice prema porodici u Srbiji. Nostalgija koja može
                prerasti u depresiju.
              </p>
            </div>
            <div class="challenge-card">
              <h3>Porodični pritisak</h3>
              <p>
                Očekivanja porodice u Srbiji, tenzije između generacija, teškoće
                u komunikaciji na daljinu.
              </p>
            </div>
            <div class="challenge-card">
              <h3>Integracija i identitet</h3>
              <p>
                Prilagođavanje novim normama bez gubitka sopstvene autentičnosti
                i kulturnog identiteta.
              </p>
            </div>
          </div>
        </div>

        <section class="section">
          <h2>Često postavljana pitanja</h2>
          <div class="faq-list">
            {
              faqSchema.map((item) => (
                <details class="faq-item">
                  <summary>
                    <h3>{item.question}</h3>
                  </summary>
                  <p set:html={item.answerHtml || item.answer} />
                </details>
              ))
            }
          </div>
        </section>

        <section class="section cta-section">
          <h2>Zakažite konsultaciju</h2>
          <p>
            Napravite prvi korak. Nudim besplatni 15-minutni uvodni razgovor
            radi upoznavanja, okvirne procene problema, što vama pruža mogućnost
            da procenite da li želite dalje da sarađujemo zajedno, a meni
            omogućava da procenim da li je integrativna psihoterapija adekvatno
            rešenje za vas.
          </p>
          <div class="cta-buttons">
            <a href="/sr/contact" class="btn-primary">Kontaktirajte me</a>
          </div>
        </section>
      </section>
    </article>
  </div>

  <style>
    .page-container {
      max-width: 860px;
      margin: 0 auto;
      padding: 2rem 1rem 4rem;
    }
    .landing-content h1 {
      font-size: 2.5rem;
      color: var(--primary-color);
      margin-bottom: 1.5rem;
    }
    .lead {
      font-size: 1.15rem;
      line-height: 1.7;
      margin-bottom: 2rem;
      border-left: 4px solid var(--primary-color);
      padding-left: 1rem;
    }
    .section {
      margin-bottom: 3rem;
    }
    .section h2 {
      font-size: 1.75rem;
      color: var(--primary-color);
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--light-bg);
    }
    .challenges-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
    .challenge-card {
      background: var(--light-bg);
      border: 1px solid var(--primary-color);
      border-radius: 8px;
      padding: 1.5rem;
    }
    .challenge-card h3 {
      color: var(--primary-color);
      margin-bottom: 0.5rem;
      font-size: 1rem;
    }
    .challenge-card p {
      margin: 0;
      font-size: 0.9rem;
    }
    .benefits-list {
      list-style: none;
      padding: 0;
      margin-top: 1rem;
    }
    .benefits-list li {
      padding: 0.5rem 0 0.5rem 1.5rem;
      position: relative;
      border-bottom: 1px solid var(--border-color);
    }
    .benefits-list li::before {
      content: "✓";
      position: absolute;
      left: 0;
      color: var(--primary-color);
      font-weight: bold;
    }
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .faq-item {
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1rem 1.5rem;
    }
    .faq-item summary {
      list-style: none;
      cursor: pointer;
    }
    .faq-item summary h3 {
      font-size: 1rem;
      margin: 0;
      color: var(--primary-color);
    }
    .faq-item p {
      margin: 0.75rem 0 0;
      font-size: 0.95rem;
    }
    .cta-section {
      background: var(--light-bg);
      border-radius: 12px;
      padding: 2rem;
      text-align: center;
    }
    .cta-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }
    .btn-primary {
      display: inline-block;
      background: var(--primary-color);
      color: #fff;
      padding: 0.75rem 2rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
    }
    .btn-primary:hover {
      opacity: 0.9;
    }
    .btn-secondary {
      display: inline-block;
      border: 2px solid var(--primary-color);
      color: var(--primary-color);
      padding: 0.75rem 2rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
    }
    .btn-secondary:hover {
      background: var(--primary-color);
      color: #fff;
    }
    .internal-links {
      margin-top: 3rem;
      padding: 1.5rem;
      background: var(--background-color);
      border: 1px solid var(--border-color);
      border-radius: 8px;
    }
    .internal-links h2 {
      font-size: 1.2rem;
      margin-bottom: 1rem;
    }
    .internal-links ul {
      list-style: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .internal-links a {
      color: var(--primary-color);
      text-decoration: underline;
    }
    @media (max-width: 768px) {
      .challenges-grid {
        grid-template-columns: 1fr;
      }
      .landing-content h1 {
        font-size: 1.75rem;
      }
    }
  </style>
</Layout>
