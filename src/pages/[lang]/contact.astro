---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { useTranslations, languages } from '../../i18n/utils';

export function getStaticPaths() {
    return Object.keys(languages).map(lang => ({
        params: { lang }
    }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const pageTitle = lang === 'sr'
    ? 'Kontakt | Online psihoterapija – Dr Tamara Medovarski'
    : 'Contact | Online Psychotherapy – Dr Tamara Medovarski';

const pageDescription = lang === 'sr'
    ? 'Zakažite besplatnu 15-minutnu konsultaciju. Online psihoterapija na srpskom i engleskom jeziku. Kontaktirajte Dr Tamaru Medovarski.'
    : 'Book a free 15-minute consultation. Online psychotherapy in Serbian and English. Contact Dr Tamara Medovarski.';
---

<Layout title={pageTitle} description={pageDescription} lang={lang as keyof typeof languages}>
    <div class="container">
        <section class="section">
            <ContactSection lang={lang as keyof typeof languages} />
        </section>
        {lang === 'sr' && (
            <section class="section internal-links-section">
                <p>
                    Dr Tamara Medovarski nudi <a href="/sr/">online psihoterapiju</a> dostupnu iz bilo kog mesta u Srbiji i inostranstvu.
                    Specijalizovana je i za <a href="/online-psihoterapija-za-dijasporu/">psihoterapiju za dijasporu</a> – na srpskom jeziku, bez obzira gde živite.
                </p>
            </section>
        )}
    </div>
</Layout>