---
import Layout from '../../layouts/Layout.astro';
import WelcomeSection from '../../components/WelcomeSection.astro';
import ApproachSection from '../../components/ApproachSection.astro';
import ForWhomSection from '../../components/ForWhomSection.astro';
import ImportantInfo from '../../components/ImportantInfo.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import NotSuitableSection from '../../components/NotSuitableSection.astro';
import BenefitsSection from '../../components/BenefitsSection.astro';

import { useTranslations, languages } from '../../i18n/utils';

export function getStaticPaths() {
    return Object.keys(languages).map(lang => ({
        params: { lang }
    }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

// SEO-optimized titles and descriptions per language
const pageTitle = lang === 'sr'
    ? 'Online psihoterapija | Dr Tamara Medovarski'
    : 'Online Psychotherapy | Dr Tamara Medovarski';

const metaDescription = lang === 'sr'
    ? 'Online psihoterapija na srpskom i engleskom jeziku. Podrška kod anksioznosti, depresije, stresa i životnih izazova. Individualne online seanse za klijente iz Srbije i dijaspore.'
    : 'Online psychotherapy in Serbian and English. Support for anxiety, depression, stress and life challenges. Individual online sessions for clients from Serbia and the diaspora.';

// FAQ schema for structured data
const homepageFAQ = lang === 'sr' ? [
    { question: 'Da li je online terapija jednako efikasna kao terapija uživo?', answer: 'Da, istraživanja pokazuju da je online psihoterapija jednako efikasna kao terapija licem u lice za anksioznost, depresiju i stres. Online format pruža i dodatne prednosti: dostupnost iz komfora vašeg doma, bez gubitka vremena na putovanje i mogućnost rada sa terapeutom iz istog kulturnog okruženja.' },
    { question: 'Koliko traje seansa?', answer: 'Trajanje jedne seanse je 50 minuta.' },
    { question: 'Kako zakazati termin?', answer: 'Možete popuniti kontakt formu, ili mi pisati na WhatsApp ili Viber na +31 6 48569129. Pre prve seanse nudim besplatni 15-minutni uvodni razgovor.' },
    { question: 'Na kojoj platformi se održavaju seanse?', answer: 'Seanse se realizuju putem Zoom-a ili Google Meet-a.' },
    { question: 'Na kom jeziku možemo raditi?', answer: 'Psihoterapiju nudim na srpskom i engleskom jeziku.' }
] : [
    { question: 'Is online therapy just as effective as in-person therapy?', answer: 'Yes, research shows that online psychotherapy is equally effective as face-to-face therapy for anxiety, depression and stress.' },
    { question: 'How long does a session last?', answer: 'Each session lasts 50 minutes.' },
    { question: 'How do I book an appointment?', answer: 'Fill out the contact form or message me on WhatsApp or Viber at +31 6 48569129. I offer a free 15-minute introductory conversation before the first session.' },
    { question: 'Which platform are sessions held on?', answer: 'Sessions are conducted via Zoom or Google Meet.' }
];
---

<Layout 
    title={pageTitle} 
    description={metaDescription}
    lang={lang as keyof typeof languages}
    faqSchema={homepageFAQ}
>
    <div class="container">
        <WelcomeSection lang={lang as keyof typeof languages} />
        <ApproachSection lang={lang as keyof typeof languages} />
        <ImportantInfo lang={lang as keyof typeof languages} />
        <ForWhomSection lang={lang as keyof typeof languages} />
        <BenefitsSection lang={lang as keyof typeof languages} />
        <ContactCTA lang={lang as keyof typeof languages} />
        <NotSuitableSection lang={lang as keyof typeof languages} />
    </div>
</Layout>