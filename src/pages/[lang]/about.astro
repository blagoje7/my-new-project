---
import Layout from '../../layouts/Layout.astro';
import AboutMe from '../../components/AboutMe.astro';
import { useTranslations, languages } from '../../i18n/utils';

export function getStaticPaths() {
    return Object.keys(languages).map(lang => ({
        params: { lang }
    }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const pageTitle = lang === 'sr'
    ? 'Dr Tamara Medovarski | Psihoterapeut i psihijatar na edukaciji'
    : lang === 'nl'
    ? 'Dr Tamara Medovarski | Psychotherapeut en psychiater in opleiding'
    : 'Dr Tamara Medovarski | Psychotherapist and Psychiatrist in Training';

const pageDescription = lang === 'sr'
    ? 'Dr Tamara Medovarski – doktor medicine, specijalizant psihijatrije i psihoterapeut. Pruža online psihoterapiju na srpskom i engleskom jeziku za klijente iz Srbije i dijaspore.'
    : lang === 'nl'
    ? 'Dr Tamara Medovarski – arts, psychiater in opleiding en psychotherapeut. Online psychotherapie in Servisch, Engels en Nederlands.'
    : 'Dr Tamara Medovarski – Medical Doctor, Psychiatrist in Training and Psychotherapist. Online psychotherapy in Serbian and English for clients in Serbia and the diaspora.';

const aboutH1 = lang === 'sr' ? 'O mojoj profesionalnoj karijeri' : lang === 'nl' ? 'Over mijn professionele ontwikkeling' : 'About my professional career';
---

<Layout title={pageTitle} description={pageDescription} lang={lang as keyof typeof languages}>
    <div class="page-container">
        <div class="about-layout">
            <div class="content-section-wrapper">
                <div class="content-wrapper">
                    <h1 class="page-title">{aboutH1}</h1>
                    <section class="content-section">
                        <AboutMe lang={lang as keyof typeof languages} />
                    </section>
                </div>
            </div>
            <div class="image-section">
                <img 
                    src="/Vodnoja-800w.avif"
                    srcset="/Vodnoja-400w.avif 400w, /Vodnoja-800w.avif 800w"
                    alt="Vodno Mountain view" 
                    sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 600px"
                    width="800"
                    height="600"
                    class="about-image"
                    loading="eager"
                    fetchpriority="high"
                />
            </div>
        </div>
    </div>
</Layout>

<style>
    .about-layout {
        display: flex;
        min-height: calc(100vh - 120px);
        gap: 0;
    }

    .content-section-wrapper {
        flex: 1;
        padding: 2rem;
        background-color: var(--background-color);
    }

    .image-section {
        flex: 0 0 50%;
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #f5f5f5;
        padding-top: 2rem;
    }

    .about-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .content-wrapper {
        max-width: 100%;
        padding: 2rem 0;
    }

    .page-title {
        margin-bottom: 2rem;
    }

    /* Mobile responsive */
    @media (max-width: 768px) {
        .about-layout {
            flex-direction: column;
        }

        .image-section {
            flex: none;
            height: 40vh;
            position: relative;
            order: 2;
        }

        .content-section-wrapper {
            padding: 1rem;
            order: 1;
        }

        .content-wrapper {
            padding: 1rem 0;
        }
    }
</style>