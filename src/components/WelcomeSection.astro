---
import { useTranslations } from '../i18n/utils';

const { lang = 'sr' } = Astro.props;
const t = useTranslations(lang);

// Define the image alt text
const imageAlt = t('header.name');
---

<section id="welcome" class="section">
    <h1 class="main-title">{t('header.title')}</h1>
    
    <div class="welcome-content">
        <div class="profile-section">
            <img 
                src="/IMG_16832-800w.avif"
                srcset="/IMG_16832-400w.avif 400w, /IMG_16832-800w.avif 800w, /IMG_16832-1200w.avif 1200w"
                alt={imageAlt}
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 343px, 377px"
                width="728"
                height="800"
                class="profile-image"
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </div>
        
        <div class="info-section">
            <div class="credentials-card">
                <h2 class="name" set:html={t('header.name')} />
                <div class="credentials-list">
                    <p class="credential" set:html={t('header.credentials.role1')} />
                    <p class="credential" set:html={t('header.credentials.role2')} />
                    <p class="credential" set:html={t('header.credentials.role3')} />
                </div>
            </div>
            
            <div class="intro-card">
                <p set:html={t('intro.description')} />
            </div>
        </div>
    </div>
</section>


