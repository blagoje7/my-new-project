---
import { useTranslations } from '../i18n/utils';
const { lang = 'sr' } = Astro.props;
const t = useTranslations(lang);
---

<section id="benefits" class="section">
    
    <h2 set:html={t('benefits.title')} />
    <div class="benefits-grid">
        
        <div class="benefit-card">
            <div class="icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M256 32C114.6 32 0 125.1 0 240c0 49.6 21.4 95 57 130.7C44.5 421.1 2.7 466 2.2 466.5c-2.2 2.3-2.8 5.7-1.5 8.7S4.8 480 8 480c66.3 0 116-31.8 140.6-51.4 32.7 12.3 69 19.4 107.4 19.4 141.4 0 256-93.1 256-208S397.4 32 256 32zm0 368c-31.5 0-61.7-4.6-89.6-13.7l-14.7-4.8-12.8 9.6c-15.8 11.9-39.3 25.6-66.1 33.8 7.3-12.6 14.5-28.1 19.9-46.3l6.9-23.2-17.7-17.7C52.2 308.9 32 275.6 32 240c0-97 100.3-176 224-176s224 79 224 176-100.3 176-224 176z"/></svg>
            </div>
            <h3 set:html={t('benefits.card1.title')} />
            <p set:html={t('benefits.card1.description')} />
        </div>

        <div class="benefit-card">
            <div class="icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" fill="currentColor" aria-hidden="true"><path d="M640 264v-16c0-8.8-7.2-16-16-16H344v-40h72c17.7 0 32-14.3 32-32V32c0-17.7-14.3-32-32-32H224c-17.7 0-32 14.3-32 32v128c0 17.7 14.3 32 32 32h72v40H16c-8.8 0-16 7.2-16 16v16c0 8.8 7.2 16 16 16h104v40H64c-17.7 0-32 14.3-32 32v128c0 17.7 14.3 32 32 32h160c17.7 0 32-14.3 32-32V352c0-17.7-14.3-32-32-32h-56v-40h304v40h-56c-17.7 0-32 14.3-32 32v128c0 17.7 14.3 32 32 32h160c17.7 0 32-14.3 32-32V352c0-17.7-14.3-32-32-32h-56v-40h104c8.8 0 16-7.2 16-16zM224 64h192v96H224V64zm0 384H96v-96h128v96zm192 0V352h128v96H416z"/></svg>
            </div>
            <h3 set:html={t('benefits.card2.title')} />
            <p set:html={t('benefits.card2.description')} />
        </div>

        <div class="benefit-card">
            <div class="icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true"><path d="M360 0H24C10.7 0 0 10.7 0 24v16c0 13.3 10.7 24 24 24 0 90.9 51.1 167.7 120.8 192C75.1 280.3 24 357.1 24 448c-13.3 0-24 10.7-24 24v16c0 13.3 10.7 24 24 24h336c13.3 0 24-10.7 24-24v-16c0-13.3-10.7-24-24-24 0-90.9-51.1-167.7-120.8-192C308.9 231.7 360 154.9 360 64c13.3 0 24-10.7 24-24V24c0-13.3-10.7-24-24-24zM192 256c70.7 0 128-57.3 128-128H64c0 70.7 57.3 128 128 128zm0 128c-70.7 0-128 57.3-128 128h256c0-70.7-57.3-128-128-128z"/></svg>
